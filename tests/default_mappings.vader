After (Restore default options):
  lua require('wordmotion').setup({
  \ mappings = { ["w"]="w", ["e"]="e", ["b"]="b", ["ge"]="ge", ["aw"]="aw", ["iw"]="iw" },
  \ })

Execute (Check default mappings):
  for map in ['iw', 'aw']
    for mode in ['x', 'o']
      Assert !empty(maparg(map, mode))
      execute mode . 'unmap' map
    endfor
  endfor
  for map in ['w', 'e', 'b', 'ge']
    for mode in ['n', 'x', 'o']
      Assert !empty(maparg(map, mode))
      execute mode . 'unmap' map
    endfor
  endfor

Execute (Check disabled specific mappings):
  lua require("wordmotion").setup({
  \ mappings = { ["w"]="", ["e"]="e", ["b"]="b", ["ge"]="ge", ["aw"]="aw", ["iw"]="" },
  \ })
  Assert empty(maparg('w', 'n'))
  Assert empty(maparg('iw', 'x'))
  Assert !empty(maparg('e', 'n'))
  Assert !empty(maparg('aw', 'x'))
