After (Restore default options):
  lua require('wordmotion').setup({
  \ mappings = { ["w"]="w", ["e"]="e", ["b"]="b", ["ge"]="ge", ["aw"]="aw", ["iw"]="iw" },
  \ })

Execute (Check mappings with custom lhs):
  lua require("wordmotion").setup({
  \ mappings = {
  \   ["w"] = "zw", ["e"] = "ze", ["b"] = "zb", ["ge"] = "zge",
  \   ["aw"] = "azw", ["iw"] = "izw",
  \ },
  \ })
  let custom_lhs = {
  \ 'iw': 'izw', 'aw': 'azw',
  \ 'w': 'zw', 'e': 'ze', 'b': 'zb', 'ge': 'zge',
  \ }
  for map in ['iw', 'aw']
    for mode in ['x', 'o']
      let lhs = custom_lhs[map]
      Assert !empty(maparg(lhs, mode))
      execute mode . 'unmap' lhs
    endfor
  endfor
  for map in ['w', 'e', 'b', 'ge']
    for mode in ['n', 'x', 'o']
      let lhs = custom_lhs[map]
      Assert !empty(maparg(lhs, mode))
      execute mode . 'unmap' lhs
    endfor
  endfor

Execute (Check disabled mappings):
  lua require("wordmotion").setup({
  \ mappings = {
  \   ["w"] = "", ["e"] = "", ["b"] = "", ["ge"] = "",
  \   ["iw"] = "", ["aw"] = "",
  \ },
  \ })
  Assert empty(maparg('zw', 'n'))
  Assert empty(maparg('ze', 'n'))
  Assert empty(maparg('zb', 'n'))
  Assert empty(maparg('zge', 'n'))
  Assert empty(maparg('izw', 'x'))
  Assert empty(maparg('azw', 'x'))
